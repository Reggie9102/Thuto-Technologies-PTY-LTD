{
  "name": "thuto-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol Server for ThutoTech Ecosystem",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
