# Server Configuration
NODE_ENV=production
MCP_SERVER_PORT=3000
FRONTEND_URLS=https://reggie9102.github.io,https://studentmart.thuto.co.za,https://fundisa.thuto.co.za

# Database (Alibaba Cloud RDS PostgreSQL)
DB_HOST=your-rds-endpoint.ap-south-1.rds.aliyuncs.com
DB_PORT=5432
DB_NAME=thuto_mcp
DB_USER=thuto_user
DB_PASSWORD=your_secure_password_here

# AI Services
DASHSCOPE_API_KEY=your_dashscope_key_here
INKUBALM_MODEL_PATH=/models/inkubalm-quantized.bin

# Security
ENCRYPTION_KEY=your_32_char_encryption_key_here_change_in_prod
DATA_RESIDENCY=ZA

# Logging
AUDIT_LOG_PATH=/app/logs/audit.log
LOG_LEVEL=info
