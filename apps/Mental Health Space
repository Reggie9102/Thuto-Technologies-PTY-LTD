  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script>
    (() => {
      "use strict";

      const $ = (selector, root = document) => root.querySelector(selector);
      const $$ = (selector, root = document) => [...root.querySelectorAll(selector)];

      const storage = {
        get(key, fallback) {
          try {
            const value = localStorage.getItem(key);
            return value ? JSON.parse(value) : fallback;
          } catch {
            return fallback;
          }
        },
        set(key, value) {
          try {
            localStorage.setItem(key, JSON.stringify(value));
            return true;
          } catch {
            return false;
          }
        }
      };

      let toastTimer;

      function showToast(message) {
        const toast = $("#toast");
        toast.textContent = message;
        toast.classList.add("show");
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.remove("show"), 3200);
      }

      function formatDate(value) {
        return new Intl.DateTimeFormat("en-ZA", {
          day: "numeric",
          month: "short",
          year: "numeric",
          hour: "2-digit",
          minute: "2-digit"
        }).format(new Date(value));
      }

      const moodMessages = {
        1: "Thank you for being honest about how heavy today feels. You do not have to solve everything at once. Consider reaching out to someone you trust or a qualified support service.",
        2: "It sounds like today has been difficult. Try lowering the bar: one small act of care, such as water, food, a short walk, or a message to someone safe.",
        3: "An okay day is still worth noticing. A short pause, a few slow breaths, or writing down one thing on your mind may help you feel more grounded.",
        4: "It is good that you are feeling positive. Take a moment to notice what has been supporting you so you can return to it when you need it.",
        5: "That is wonderful to hear. Enjoy this moment and consider saving a few words about what made today feel good."
      };

      let selectedMood = null;
      let moodEntries = storage.get("mhc-mood-checkins", []);

      $$(".mood-button").forEach(button => {
        button.addEventListener("click", () => {
          selectedMood = Number(button.dataset.mood);
          $$(".mood-button").forEach(item => item.setAttribute("aria-pressed", String(item === button)));
          $("#moodResponse").textContent = moodMessages[selectedMood];
          $("#saveMood").disabled = false;
        });
      });

      function renderMoodHistory() {
        const container = $("#moodHistory");
        container.replaceChildren();

        if (!moodEntries.length) return;

        moodEntries.slice(0, 5).forEach(entry => {
          const item = document.createElement("div");
          item.className = "history-item";

          const content = document.createElement("div");
          const title = document.createElement("strong");
          title.textContent = entry.label;
          const date = document.createElement("span");
          date.textContent = formatDate(entry.date);
          content.append(title, date);

          if (entry.note) {
            const note = document.createElement("p");
            note.textContent = entry.note;
            content.append(note);
          }

          const remove = document.createElement("button");
          remove.type = "button";
          remove.className = "button danger small";
          remove.textContent = "Remove";
          remove.addEventListener("click", () => {
            moodEntries = moodEntries.filter(item => item.id !== entry.id);
            storage.set("mhc-mood-checkins", moodEntries);
            renderMoodHistory();
            showToast("Check-in removed.");
          });

          item.append(content, remove);
          container.append(item);
        });
      }

      $("#saveMood").addEventListener("click", () => {
        if (!selectedMood) return;

        moodEntries.unshift({
          id: Date.now(),
          mood: selectedMood,
          label: $(".mood-button[aria-pressed='true']").dataset.label,
          note: $("#moodNote").value.trim(),
          date: new Date().toISOString()
        });

        moodEntries = moodEntries.slice(0, 30);
        const saved = storage.set("mhc-mood-checkins", moodEntries);
        renderMoodHistory();
        $("#moodNote").value = "";
        showToast(saved ? "Your check-in was saved on this device." : "Your browser could not save this check-in.");
      });

      renderMoodHistory();

      const phases = [
        { name: "Inhale", duration: 4 },
        { name: "Hold", duration: 4 },
        { name: "Exhale", duration: 6 },
        { name: "Rest", duration: 2 }
      ];

      let breathing = false;
      let phaseIndex = 0;
      let secondsLeft = phases[0].duration;
      let breathingTimer = null;
      let heroTimer = null;
      let heroRunning = false;
      let heroPhase = 0;
      let heroSeconds = phases[0].duration;

      function renderBreathing() {
        const phase = phases[phaseIndex];
        $("#breathPhase").textContent = breathing ? phase.name : "Ready";
        $("#breathCount").textContent = breathing ? `${secondsLeft} ${secondsLeft === 1 ? "second" : "seconds"}` : "Begin when you are comfortable";
        $("#breathOrb").className = `large-orb ${breathing ? phase.name.toLowerCase() : ""}`;
        $("#breathButton").textContent = breathing ? "Pause exercise" : phaseIndex || secondsLeft !== phases[0].duration ? "Resume exercise" : "Start exercise";
        $$("#phaseList li").forEach((item, index) => item.classList.toggle("active", breathing && index === phaseIndex));
      }

      function stopBreathing() {
        breathing = false;
        clearInterval(breathingTimer);
        breathingTimer = null;
        renderBreathing();
      }

      function advanceBreathing() {
        phaseIndex = (phaseIndex + 1) % phases.length;
        secondsLeft = phases[phaseIndex].duration;
        renderBreathing();
      }

      $("#breathButton").addEventListener("click", () => {
        if (breathing) {
          stopBreathing();
          return;
        }

        breathing = true;
        renderBreathing();
        breathingTimer = setInterval(() => {
          secondsLeft -= 1;
          if (secondsLeft <= 0) {
            advanceBreathing();
          } else {
            renderBreathing();
          }
        }, 1000);
      });

      $("#breathReset").addEventListener("click", () => {
        stopBreathing();
        phaseIndex = 0;
        secondsLeft = phases[0].duration;
        renderBreathing();
      });

      function renderHeroBreath() {
        const phase = phases[heroPhase];
        $("#heroBreathPhase").textContent = heroRunning ? phase.name : "Breathe";
        $("#heroBreathCount").textContent = heroRunning ? `${heroSeconds} ${heroSeconds === 1 ? "second" : "seconds"}` : "4 seconds";
        $("#heroBreathOrb").className = `breath-orb ${heroRunning ? phase.name.toLowerCase() : ""}`;
        $("#heroBreathButton").textContent = heroRunning ? "Pause" : "Start breathing";
      }

      $("#heroBreathButton").addEventListener("click", () => {
        heroRunning = !heroRunning;
        clearInterval(heroTimer);
        heroTimer = null;

        if (heroRunning) {
          renderHeroBreath();
          heroTimer = setInterval(() => {
            heroSeconds -= 1;
            if (heroSeconds <= 0) {
              heroPhase = (heroPhase + 1) % phases.length;
              heroSeconds = phases[heroPhase].duration;
            }
            renderHeroBreath();
          }, 1000);
        } else {
          renderHeroBreath();
        }
      });

      let journalEntries = storage.get("mhc-journal-entries", []);

      function renderJournal() {
        const container = $("#journalList");
        container.replaceChildren();

        if (!journalEntries.length) {
          const empty = document.createElement("div");
          empty.className = "empty-state";
          empty.innerHTML = "<strong>Your journal is clear.</strong>Write a reflection when you feel ready.";
          container.append(empty);
          return;
        }

        journalEntries.forEach(entry => {
          const article = document.createElement("article");
          article.className = "journal-entry";

          const header = document.createElement("div");
          header.className = "journal-entry-header";

          const time = document.createElement("time");
          time.dateTime = entry.date;
          time.textContent = formatDate(entry.date);

          const remove = document.createElement("button");
          remove.type = "button";
          remove.className = "button danger small";
          remove.textContent = "Delete";
          remove.addEventListener("click", () => {
            journalEntries = journalEntries.filter(item => item.id !== entry.id);
            storage.set("mhc-journal-entries", journalEntries);
            renderJournal();
            showToast("Journal entry deleted.");
          });

          const text = document.createElement("p");
          text.textContent = entry.text;

          header.append(time, remove);
          article.append(header, text);
          container.append(article);
        });
      }

      $("#journalEntry").addEventListener("input", event => {
        $("#saveJournal").disabled = !event.target.value.trim();
      });

      $("#saveJournal").addEventListener("click", () => {
        const text = $("#journalEntry").value.trim();
        if (!text) return;

        journalEntries.unshift({
          id: Date.now(),
          text,
          date: new Date().toISOString()
        });

        journalEntries = journalEntries.slice(0, 100);
        const saved = storage.set("mhc-journal-entries", journalEntries);
        $("#journalEntry").value = "";
        $("#saveJournal").disabled = true;
        renderJournal();
        showToast(saved ? "Your reflection was saved on this device." : "Your browser could not save this entry.");
      });

      renderJournal();
    })();
  </script>
</body>
