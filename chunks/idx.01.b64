<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ThutoTech — AI Education Platform for South Africa</title>
<meta name="description" content="ThutoTech builds AI tools for South African learners and teachers. From Grade 1 to Graduation. Founded by a PhD researcher. Offline-first. POPIA-compliant. 11 SA languages.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@4;0;500;600;700&amh�&AsPyd&display=swap" rel="stylesheet>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<style>
:root{
  /* Brand palette from Brand Guide */
  --corporate-navy:#0A2E5A;
  --corporate-navy-light:#1A4A7F;
  --corporate-navy-dark:#061A33;
  --harvest-gold:#D4AF37;
  --harvest-gold-light:#E5C44A;
  --harvest-gold-dark:#B8961F;
  --vibrant-orange:#FF6B35;
  --vibrant-orange-light:#FF8F00;
  --vibrant-orange-dark:#E55A2B;
  --market-cyan:#28A9E1;
  --market-cyan-light:#5BC3EA;
  --market-cyan-dark:#1B8BC0;
  --research-blue:#1E3A8A;
  --research-blue-light:#2D4BA0;
  --ecosystem-emerald:#28A492;
  --ecosystem-emerald-light:#3BB8A5;
  --electric-cyan:#00D9FF;
  
  /* Neutral */
  --white:#FFFFFF;
  --gray-50:#F8FAFC;
  --gray-100:#F1F5F9;
  --gray-200:#E2E8F0;
  --gray-300:#CBD5E1;
  --gray-400:#94A3B8;
  --gray-500:#64748B;
  --gray-600:#475569;
  --gray-700:#334155;
  --success:#10B981;
  --warning:#F59E0B;
  
  /* UI */
  --radius:14px;
  --radius-lg:20px;
  --radius-xl:28px;
  --shadow-sm:0 1px 3px rgba(10,46,90,.08);
  --shadow-md:0 4px 20px rgba(10,46,90,.1);
  --shadow-lg:0 10px 40px rgba(10,46,90,.12);
  --transition:all .3s cubic-bezier(.4,0,.2,1);
}

*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  font-family:'Inter',sans-serif;
  color:var(--gray-700);
  line-height:1.6;
  background:var(--white);
  overflow-x:hidden;
}
h1,h2,h3,h4,h5{font-family:'Space Grotesk',sans-serif;font-weight:700;letter-spacing:-.02em}
.container{max-width:1400px;margin:0 auto;padding:0 2rem}

/* ============ TOP BAR ============ */
.topbar{
  background:var(--corporate-navy);
  padding:8px 2rem;
  display:flex;align-items:center;justify-content:center;gap:10px;
  font-size:.75rem;color:rgba(255,255,255,.85);
}
.topbar .badge{
  background:linear-gradient(135deg,var(--harvest-gold),var(--vibrant-orange));
  color:var(--corporate-navy);
  padding:3px 10px;border-radius:4px;
  font-size:.65rem;font-weight:700;letter-spacing:.5px;
}

/* ============ NAVBAR ============ */
.navbar{
  position:sticky;top:0;z-index:1000;
  background:rgba(255,255,255,.95);
  backdrop-filter:blur(20px);
  border-bottom:1px solid var(--gray-200);
}
.nav-container{
  max-width:1400px;margin:0 auto;
  padding:.9rem 2rem;
  display:flex;align-items:center;justify-content:space-between;
}
.logo{display:flex;align-items:center;gap:12px;text-decoration:none}
.logo-icon{
  width:44px;height:44px;
  background:linear-gradient(135deg,var(--corporate-navy),var(--corporate-navy-light));
  border-radius:12px;
  display:flex;align-items:center;justify-content:center;
  color:var(--harvest-gold);font-size:1.3rem;
  box-shadow:0 4px 15px rgba(10,46,90,.2);
  position:relative;
}
.logo-icon::after{
  content:'';position:absolute;inset:3px;
  border:1px solid rgba(212,175,55,.3);border-radius:9px;
}
.logo-text .brand{font-size:1.25rem;font-weight:700;color:var(--corporate-navy);line-height:1.1}
.logo-text .brand span{color:var(--harvest-gold)}
.logo-text .sub{font-size:.62rem;color:var(--gray-500);text-transform:uppercase;letter-spacing:1.5px;font-weight:600}
.nav-links{display:flex;list-style:none;gap:.3rem;align-items:center}
.nav-links a{
  color:var(--gray-600);text-decoration:none;font-weight:500;font-size:.88rem;
  padding:8px 14px;border-radius:10px;transition:var(--transition);
}
.nav-links a:hover{background:rgba(40,169,225,.08);color:var(--market-cyan)}
.nav-actions{display:flex;gap:.6rem;align-items:center}
.btn{
  padding:10px 20px;border:none;border-radius:10px;
  font-size:.88rem;font-weight:600;cursor:pointer;
  transition:var(--transition);text-decoration:none;
  display:inline-flex;align-items:center;gap:6px;font-family:inherit;
}
.btn-primary{background:linear-gradient(135deg,var(--harvest-gold),var(--harvest-gold-dark));color:var(--corporate-navy);box-shadow:0 4px 15px rgba(212,175,55,.3)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(212,175,55,.4)}
.btn-outline{background:white;color:var(--corporate-navy);border:2px solid var(--corporate-navy)}
.btn-outline:hover{background:var(--corporate-navy);color:white}
.btn-navy{background:var(--corporate-navy);color:white}
.btn-navy:hover{background:var(--corporate-navy-light);transform:translateY(-2px)}
.mobile-toggle{display:none;background:none;border:none;font-size:1.5rem;cursor:pointer;color:var(--corporate-navy)}

/* ============ HERO ============ */
.hero{
  background:linear-gradient(135deg,var(--corporate-navy) 0%,var(--corporate-navy-light) 60%,var(--research-blue) 100%);
  padding:5rem 2rem 6rem;position:relative;overflow:hidden;
}
.hero::before{
  content:'';position:absolute;top:-50%;right:-10%;
  width:600px;height:600px;
  background:radial-gradient(circle,rgba(212,175,55,.15) 0%,transparent 70%);
  border-radius:50%;
}
.hero::after{
  content:'';position:absolute;bottom:-30%;left:-5%;
  width:400px;height:400px;
  background:radial-gradient(circle,rgba(40,169,225,.1) 0%,transparent 70%);
  border-radius:50%;
}
.hero-container{max-width:1400px;margin:0 auto;
  display:grid;grid-template-columns:1.2fr 1fr;gap:3rem;
  align-items:center;position:relative;z-index:1;
}
.hero-pill{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(212,175,55,.15);border:1px solid rgba(212,175,55,.3);
  padding:6px 16px;border-radius:20px;
  color:var(--harvest-gold-light);font-size:.78rem;font-weight:600;
  margin-bottom:1.5rem;
}
.hero h1{
  font-size:3.2rem;color:white;line-height:1.1;margin-bottom:1.2rem;
}
.hero h1 .accent{color:var(--harvest-gold)}
.hero h1 .sub-accent{color:var(--market-cyan-light)}
.hero-sub{
  font-size:1.1rem;color:rgba(255,255,255,.85);
  margin-bottom:2rem;max-width:560px;line-height:1.7;
}
.hero-founder{
  display:flex;align-items:center;gap:14px;
  background:rgba(255,255,255,.08);
  backdrop-filter:blur(10px);
  border:1px solid rgba(255,255,255,.15);
  padding:14px 18px;border-radius:14px;
  margin-bottom:2rem;max-width:540px;
}
.founder-avatar{
  width:52px;height:52px;border-radius:50%;
  background:linear-gradient(135deg,var(--harvest-gold),var(--vibrant-orange));
  display:flex;align-items:center;justify-content:center;
  color:var(--corporate-navy);font-weight:700;font-size:1.1rem;
  flex-shrink:0;
}
.founder-info{color:white}
.founder-info strong{display:block;font-size:.88rem;margin-bottom:2px}
.founder-info small{color:rgba(255,255,255,.7);font-size:.75rem}
.hero-badges{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:2rem}
.hero-badge{
  background:rgba(255,255,255,.1);
  backdrop-filter:blur(10px);
  border:1px solid rgba(255,255,255,.2);
  padding:6px 14px;border-radius:10px;
  color:white;font-size:.78rem;font-weight:600;
  display:flex;align-items:center;gap:6px;
}
.hero-badge i{font-size:.85rem}
.hero-buttons{display:flex;gap:1rem;flex-wrap:wrap}
.hero-stats{
  display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;
  margin-top:3rem;padding-top:2rem;
  border-top:1px solid rgba(255,255,255,.1);
}
.stat-item{text-align:center}
.stat-item h3{color:var(--harvest-gold);font-size:1.8rem;font-weight:700;margin-bottom:2px}
.stat-item p{color:rgba(255,255,255,.7);font-size:.78rem}

/* Hero Visual — Ecosystem Orbits */
.hero-visual{position:relative;height:500px}
.orbit{
  position:absolute;top:50%;left:50%;
  border:1px dashed rgba(255,255,255,.15);
  border-radius:50%;
  transform:translate(-50%,-50%);
}
.orbit.o1{width:200px;height:200px}
.orbit.o2{width:320px;height:320px}
.orbit.o3{width:440px;height:440px}
.orbit-center{
  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  width:90px;height:90px;border-radius:50%;
  background:linear-gradient(135deg,var(--harvest-gold),var(--vibrant-orange));
  display:flex;align-items:center;justify-content:center;
  color:var(--corporate-navy);font-size:2rem;
  box-shadow:0 10px 40px rgba(212,175,55,.4);
  z-index:5;
}
.orbit-node{
  position:absolute;
  width:70px;height:70px;border-radius:16px;
  background:white;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  font-size:.6rem;font-weight:600;color:var(--corporate-navy);
  box-shadow:0 8px 24px rgba(0,0,0,.2);
  padding:6px;text-align:center;
  transition:var(--transition);cursor:pointer;
}
.orbit-node:hover{transform:scale(1.1)}
.orbit-node i{font-size:1.2rem;margin-bottom:3px}
.orbit-node.fundisa{top:50%;left:50%;transform:translate(-50%,-240%);color:var(--harvest-gold)}
.orbit-node.matric{top:50%;left:50%;transform:translate(180%,-50%);color:var(--vibrant-orange)}
.orbit-node.mart{top:50%;left:50%;transform:translate(-50%,140%);color:var(--market-cyan)}
.orbit-node.lift{top:50%;left:50%;transform:translate(-280%,-50%);color:var(--ecosystem-emerald)}
.orbit-node.academy{top:50%;left:50%;transform:translate(-200%,-200%);color:var(--harvest-gold)}
.orbit-node.research{top:50%;left:50%;transform:translate(110%,-220%);color:var(--research-blue)}
.orbit-node.learner{top:50%;left:50%;transform:translate(180%,150%);color:var(--ai-purple)}
.orbit-node.mental{top:50%;left:50%;transform:translate(-240%,120%);color:var(--ecosystem-emerald)}
.orbit-node i{color:inherit}

/* ============ TRUST BAR ============ */
.trust-bar{
  background:var(--gray-50);
  padding:2rem;border-bottom:1px solid var(--gray-200);
}
.trust-grid{
  max-width:1400px;margin:0 auto;
  display:grid;grid-template-columns:repeat(5,1fr);gap:2rem;
  align-items:center;
}
.trust-item{
  display:flex;align-items:center;gap:10px;
  color:var(--gray-600);font-size:.82rem;
}
.trust-item i{color:var(--harvest-gold);font-size:1.1rem}
.trust-item strong{color:var(--corporate-navy);display:block;font-size:.78rem}
.trust-item small{color:var(--gray-500);font-size:.72rem}

/* ============ SECTIONS ============ */
.section{padding:5rem 2rem}
.section-header{text-align:center;margin-bottom:3rem;max-width:800px;margin-left:auto;margin-right:auto}
.section-tag{
  display:inline-flex;align-items:center;gap:6px;
  padding:6px 14px;border-radius:20px;
  font-size:.78rem;font-weight:600;margin-bottom:1rem;
}
.section-tag.gold{background:rgba(212,175,55,.1);color:var(--harvest-gold)}
.section-tag.orange{background:rgba(255,107,53,.1);color:var(--vibrant-orange)}
.section-tag.cyan{background:rgba(40,169,225,.1);color:var(--market-cyan)}
.section-tag.navy{background:rgba(10,46,90,.08);color:var(--corporate-navy)}
.section-tag.research{background:rgba(30,58,138,.08);color:var(--research-blue)}
.section-tag.emerald{background:rgba(40,164,146,.1);color:var(--ecosystem-emerald)}
.section-header h2{font-size:2.4rem;color:var(--corporate-navy);margin-bottom:.8rem}
.section-header p{color:var(--gray-500);font-size:1.05rem;line-height:1.7}

/* ============ LIVE PRODUCTS ============ */
.live-section{background:white}
.status-legend{
  display:flex;justify-content:center;gap:1.5rem;flex-wrap:wrap;margin-bottom:2.5rem;
}
.status-pill{
  display:inline-flex;align-items:center;gap:6px;
  padding:6px 12px;border-radius:20px;
  font-size:.75rem;font-weight:600;
  background:var(--gray-100);color:var(--gray-600);
}
.status-pill .dot{width:8px;height:8px;border-radius:50%}
.status-pill.live .dot{background:var(--success)}
.status-pill.beta .dot{background:var(--warning)}
.status-pill.pilot .dot{background:var(--market-cyan)}
.status-pill.roadmap .dot{background:var(--gray-400)}

.products-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;
}
.product-card{
  background:white;border:1px solid var(--gray-200);
  border-radius:var(--radius-lg);padding:2rem;
  transition:var(--transition);position:relative;overflow:hidden;
  display:flex;flex-direction:column;
}
.product-card:hover{transform:translateY(-5px);box-shadow:var(--shadow-lg);border-color:var(--market-cyan)}
.product-card::before{
  content:'';position:absolute;top:0;left:0;right:0;height:3px;
  background:var(--card-accent,var(--market-cyan));
}
.product-card[data-accent="gold"]{--card-accent:var(--harvest-gold)}
.product-card[data-accent="orange"]{--card-accent:var(--vibrant-orange)}
.product-card[data-accent="cyan"]{--card-accent:var(--market-cyan)}
.product-card[data-accent="emerald"]{--card-accent:var(--ecosystem-emerald)}
.product-card[data-accent="research"]{--card-accent:var(--research-blue)}
.product-card[data-accent="navy"]{--card-accent:var(--corporate-navy)}

.product-status{
  position:absolute;top:1.2rem;right:1.2rem;
  display:inline-flex;align-items:center;gap:5px;
  padding:3px 10px;border-radius:12px;
  font-size:.65rem;font-weight:700;
  background:var(--gray-100);color:var(--gray-600);
}
.product-status.live{background:rgba(16,185,129,.1);color:var(--success)}
.product-status.beta{background:rgba(245,158,11,.1);color:var(--warning)}
.product-status.pilot{background:rgba(40,169,225,.1);color:var(--market-cyan)}

.product-icon{
  width:56px;height:56px;border-radius:14px;
  display:flex;align-items:center;justify-content:center;
  font-size:1.4rem;margin-bottom:1.2rem;
  background:rgba(40,169,225,.08);color:var(--market-cyan);
}
.product-card[data-accent="gold"] .product-icon{background:rgba(212,175,55,.1);color:var(--harvest-gold)}
.product-card[data-accent="orange"] .product-icon{background:rgba(255,107,53,.1);color:var(--vibrant-orange)}
.product-card[data-accent="emerald"] .product-icon{background:rgba(40,164,146,.1);color:var(--ecosystem-emerald)}
.product